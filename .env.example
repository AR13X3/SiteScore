# Copy to .env (run.py install does this for you). Every key is optional:
# a missing key means that source falls back to cached or mock data.

# Google Places API (New). Used only as backtest ground truth
# (rating, review count, open/closed), never as a model input.
GOOGLE_PLACES_API_KEY=

# Transport for NSW Open Data. Only needed for GTFS stop locations.
# Station patronage (entries/exits) downloads without a key.
TFNSW_API_KEY=

# Which config/regions/<id>.yaml to use.
SITESCORE_REGION=parramatta

# 1 = never touch the network; use cached real data where present, mock otherwise.
SITESCORE_OFFLINE=0

# 1 = use mock data everywhere, even where real data has been fetched (demo safety switch).
SITESCORE_FORCE_MOCK=0

# Machine-local folder for large regenerable files (virtualenv, raw downloads).
# Default: a folder outside OneDrive/Dropbox if the repo lives in one, else ./.local
SITESCORE_CACHE_DIR=
